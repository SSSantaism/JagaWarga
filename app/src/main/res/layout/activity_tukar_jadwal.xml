<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    tools:context=".TukarJadwalActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Tombol Back biru, icon putih -->

        <!-- Judul -->

        <!-- Ilustrasi (lebar penuh, tinggi pakai aspect ratio supaya dinamis) -->

        <!-- Label ID Jadwal Saya -->

        <ImageView
            android:id="@+id/imgAbsenIllustration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="64dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/cd_absen_illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/tukar_jadwal_illustration"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTitleAbsen" />

        <ImageButton
            android:id="@+id/btnBackAbsen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_back_button_blue"
            android:contentDescription="@string/cd_kembali"
            android:padding="10dp"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/textIdJadwalSaya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:labelFor="@id/inputIdJadwalSaya"
            android:text="@string/label_id_jadwal_saya"
            android:textColor="@color/gray"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgAbsenIllustration" />

        <EditText
            android:id="@+id/inputIdJadwalSaya"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_background"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textIdJadwalSaya" />

        <TextView
            android:id="@+id/textIdJadwalTujuan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/inputIdJadwalTujuan"
            android:text="@string/label_id_jadwal_tujuan"
            android:textColor="@color/gray"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputIdJadwalSaya" />

        <EditText
            android:id="@+id/inputIdJadwalTujuan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_background"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textIdJadwalTujuan" />

        <Button
            android:id="@+id/btnTukarAbsen"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_button"
            android:backgroundTint="@color/blue"
            android:text="Tukar Jadwal"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputIdJadwalTujuan"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/textTitleAbsen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tukar Jadwal"
            android:textColor="@color/blue"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="@id/btnBackAbsen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBackAbsen" />

        <!-- Input ID Jadwal Saya -->

        <!-- Label ID Jadwal Tujuan -->

        <!-- Input ID Jadwal Tujuan -->

        <!-- Tombol Tukar Jadwal -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
